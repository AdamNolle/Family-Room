<Window x:Class="FamilyRoom.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#FFF8F2"><NavigationView x:Name="Navigation" PaneDisplayMode="Left" SelectionChanged="SectionChanged">
    <NavigationView.MenuItems><NavigationViewItem Content="Home" Tag="home" Icon="Home"/><NavigationViewItem Content="Library" Tag="library" Icon="Pictures"/><NavigationViewItem Content="Recently Deleted" Tag="trash" Icon="Delete"/><NavigationViewItem Content="Albums" Tag="albums" Icon="Folder"/><NavigationViewItem Content="People" Tag="people" Icon="People"/><NavigationViewItem Content="Theater" Tag="theater" Icon="Video"/><NavigationViewItem Content="Ask your videos" Tag="video-finder" Icon="Find"/><NavigationViewItem Content="Recovery &amp; backup" Tag="settings" Icon="Save"/></NavigationView.MenuItems>
    <ScrollViewer><StackPanel Padding="28" Spacing="16">
      <TextBlock Text="Family Room" FontSize="32" FontFamily="Georgia"/>
      <ComboBox x:Name="Rooms" SelectionChanged="RoomChanged" PlaceholderText="Choose a Room"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="RoomName" PlaceholderText="New Room name" Width="250"/><Button Content="Create Room" Click="CreateRoom"/><Button Content="Import media" Click="ImportMedia"/></StackPanel>
      <Border x:Name="RoomSetupPanel" Visibility="Collapsed" Background="#FFFFFCFA" BorderBrush="#FFE6D9CF" BorderThickness="1" CornerRadius="14" Padding="18" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <TextBlock Text="Get your Room ready" FontSize="22" FontFamily="Georgia"/>
          <TextBlock x:Name="RoomSetupSummary" TextWrapping="Wrap" Opacity="0.72"/>
          <TextBlock x:Name="RoomSetupStorage" TextWrapping="Wrap"/>
          <TextBlock x:Name="RoomSetupUploads" TextWrapping="Wrap" Opacity="0.72"/>
          <TextBlock x:Name="RoomSetupRecovery" TextWrapping="Wrap"/>
          <TextBlock x:Name="RoomSetupContribution" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border x:Name="FolderUploadPanel" Visibility="Collapsed" Background="#FFFFFCFA" BorderBrush="#FFE6D9CF" BorderThickness="1" CornerRadius="14" Padding="18" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Spacing="8">
          <TextBlock Text="Automatic uploads from this device" FontSize="20" FontFamily="Georgia"/>
          <TextBlock x:Name="FolderUploadDescription" TextWrapping="Wrap" Opacity="0.72"/>
          <TextBlock x:Name="FolderUploadMemberNote" Visibility="Collapsed" TextWrapping="Wrap"/>
          <StackPanel x:Name="FolderUploadControls" Spacing="8">
            <CheckBox x:Name="IncludeExistingWatch" Content="Also import existing files in this folder"/>
            <TextBox x:Name="ExcludedWatchExtensions" PlaceholderText="Excluded extensions, comma separated (for example: mp4, heic)"/>
            <Button Content="Choose folder and start uploads" Click="AddFolderWatch" HorizontalAlignment="Left"/>
          </StackPanel>
          <TextBlock x:Name="FolderWatchStatus" TextWrapping="Wrap" Opacity="0.72"/>
          <ItemsControl x:Name="FolderWatches"/>
        </StackPanel>
      </Border>
      <TextBox x:Name="Search" PlaceholderText="Find caption, filename, or Person" TextChanged="SearchChanged"/>
    <StackPanel x:Name="LibraryFilters" Orientation="Vertical" Spacing="8" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="YearFilter" Width="140" PlaceholderText="All years" SelectedValuePath="Tag" SelectionChanged="LibraryFilterChanged"/>
          <ComboBox x:Name="MomentFilter" Width="220" PlaceholderText="All Moments" SelectedValuePath="Tag" SelectionChanged="LibraryFilterChanged"/>
          <CheckBox x:Name="MatchAllPeople" Content="Match all selected People" Checked="PeopleMatchChanged" Unchecked="PeopleMatchChanged" VerticalAlignment="Center"/>
          <Button Content="Clear People" Click="ClearPeopleFilter"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Height="46">
          <StackPanel x:Name="PersonFilters" Orientation="Horizontal" Spacing="12"/>
        </ScrollViewer>
      </StackPanel>
      <TextBlock x:Name="Status" TextWrapping="Wrap"/>
      <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Spacing="12" MaxWidth="820">
        <TextBlock Text="Recovery &amp; backup" FontSize="28" FontFamily="Georgia"/>
        <TextBlock Text="Your full encrypted backup preserves the library and organization. Keep the recovery key separate from the backup. Restoring replaces only an empty library; storage connections stay paused until you review them." TextWrapping="Wrap" Opacity="0.72"/>
        <Button x:Name="RevealRecoveryKeyButton" Content="Show recovery key" Click="RevealRecoveryKey" HorizontalAlignment="Left"/>
        <TextBlock x:Name="RecoveryKeyText" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Button Content="Create encrypted backup" Click="SaveEncryptedBackup" HorizontalAlignment="Left"/>
        <PasswordBox x:Name="RecoveryKeyInput" PlaceholderText="Recovery key for this backup" PasswordChanged="RecoveryKeyChanged"/>
        <Button x:Name="RestoreBackupButton" Content="Restore into empty library" Click="RestoreEncryptedBackup" IsEnabled="False" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel x:Name="VideoFinderPanel" Visibility="Collapsed" Spacing="12" MaxWidth="820">
        <TextBlock Text="Ask your videos" FontSize="28" FontFamily="Georgia"/>
        <TextBlock Text="Search on-device speech and what appears in video frames. FFmpeg and Tesseract find on-screen words; optional whisper.cpp transcribes speech. A loopback-only local vision model can suggest visible objects across up to 48 frames, clearly marked for you to verify. Results cite evidence and open at that moment. Follow-up clues build on your last question; a new quoted phrase starts fresh." TextWrapping="Wrap" Opacity="0.72"/>
        <TextBox x:Name="VideoQuestion" PlaceholderText="Try: Where does the sign say ‘Happy Birthday’?" KeyDown="VideoQuestionKeyDown"/>
        <CheckBox x:Name="IncludeRemoteVideos" Content="Include remote-only videos (download originals to this device)"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="VideoModality" SelectedIndex="0" Width="180"><ComboBoxItem Content="Speech + frames" Tag="all"/><ComboBoxItem Content="Spoken words" Tag="audio"/><ComboBoxItem Content="On-screen text" Tag="frame"/></ComboBox>
          <Button x:Name="AskVideos" Content="Find moments" Click="SearchVideos"/>
          <Button Content="Clear" Click="ClearVideoSearch"/>
        </StackPanel>
        <TextBlock x:Name="VideoCoverage" TextWrapping="Wrap" Opacity="0.72"/>
        <ItemsControl x:Name="VideoResults"/>
      </StackPanel>
      <StackPanel x:Name="ScreeningPanel" Visibility="Collapsed" Spacing="10">
        <TextBlock x:Name="ScreeningHeading" FontSize="22" FontFamily="Georgia" TextWrapping="Wrap"/>
        <Grid Height="420">
          <MediaPlayerElement x:Name="ScreeningPlayer" AreTransportControlsEnabled="True"/>
          <Border x:Name="ScreeningCaptionPanel" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="900" Margin="24" Padding="18,10" CornerRadius="12" Background="#D9000000" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ScreeningCaptionText" Foreground="White" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="PreviousFilm" Content="Previous film" Click="PreviousFilmClicked"/>
          <Button x:Name="NextFilm" Content="Next film" Click="NextFilmClicked"/>
          <CheckBox x:Name="SpokenCaptionsToggle" Content="Spoken captions" IsChecked="True" IsEnabled="False" Visibility="Collapsed" Checked="SpokenCaptionsChanged" Unchecked="SpokenCaptionsChanged"/>
        </StackPanel>
      </StackPanel>
      <ItemsControl x:Name="ContentItems"/>
      <TextBlock Text="Your device code" FontWeight="SemiBold"/><TextBox x:Name="DeviceCode" IsReadOnly="True" TextWrapping="Wrap"/>
      <TextBlock Text="Invitations to review" FontSize="20" FontFamily="Georgia"/>
      <StackPanel x:Name="PendingInvitations" Spacing="8"/>
      <TextBox x:Name="Invitation" PlaceholderText="Device-bound invitation" TextChanged="InvitationChanged"/>
      <Button Content="Review invitation" Click="ReviewInvitation"/>
      <StackPanel x:Name="InvitationPreviewPanel" Visibility="Collapsed" Spacing="8">
        <TextBlock x:Name="InvitationPreviewText" TextWrapping="Wrap"/>
        <Button Content="Save for review" Click="StageInvitation" HorizontalAlignment="Left"/>
      </StackPanel>
      <TextBlock x:Name="RoomStorageOwnerNote" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.72"/>
      <StackPanel x:Name="RoomStorageControls" Spacing="8">
        <TextBox x:Name="Gateway" PlaceholderText="Room gateway HTTPS address"/>
        <Button Content="Connect gateway" Click="ConnectGateway" HorizontalAlignment="Left"/>
        <TextBlock Text="Upload destinations" FontSize="20" FontFamily="Georgia"/>
        <ItemsControl x:Name="StorageSources"/>
      </StackPanel>
      <Button Content="Sync Room" Click="SyncRoom" HorizontalAlignment="Left"/>
      <StackPanel x:Name="MembersPanel" Visibility="Collapsed" Spacing="8" MaxWidth="820">
        <TextBlock x:Name="MembersHeading" Text="Room members" FontSize="20" FontFamily="Georgia"/>
        <TextBlock Text="People named in photos do not receive access. Removing a device rotates keys for future content; downloaded copies cannot be recalled." TextWrapping="Wrap" Opacity="0.72"/>
        <ItemsControl x:Name="RoomMembers"/>
        <StackPanel x:Name="OwnershipPreparePanel" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
          <TextBlock Text="Room ownership" FontSize="20" FontFamily="Georgia"/>
          <TextBlock Text="Transfer to an existing Member. They must accept the signed offer on their device." TextWrapping="Wrap" Opacity="0.72"/>
          <ComboBox x:Name="OwnershipSuccessor" PlaceholderText="Choose the new owner"/>
          <Button Content="Prepare transfer offer" Click="PrepareOwnershipTransfer" HorizontalAlignment="Left"/>
          <TextBox x:Name="OwnershipOffer" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="84" PlaceholderText="The signed offer will appear here"/>
          <Button Content="Copy signed offer" Click="CopyOwnershipOffer" HorizontalAlignment="Left"/>
          <TextBlock Text="Share this offer privately. The previous owner becomes an admin (or viewer for an album-only Room), and future contributions use a rotated key." TextWrapping="Wrap" Opacity="0.72"/>
        </StackPanel>
        <StackPanel x:Name="OwnershipAcceptPanel" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
          <TextBlock Text="Accept ownership offer" FontSize="20" FontFamily="Georgia"/>
          <TextBlock Text="Paste an offer shared with this device. Acceptance makes this device the owner and rotates the key for future contributions." TextWrapping="Wrap" Opacity="0.72"/>
          <TextBox x:Name="OwnershipOfferInput" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="84" PlaceholderText="Signed ownership offer"/>
          <Button Content="Review ownership offer" Click="ReviewOwnershipOffer" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel x:Name="LeaveRoomPanel" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
          <TextBlock Text="Leave Room" FontSize="20" FontFamily="Georgia"/>
          <TextBlock x:Name="LeaveRoomNote" TextWrapping="Wrap" Opacity="0.72"/>
          <Button x:Name="LeaveRoomButton" Content="Leave Room" Click="LeaveRoomClicked" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
      <TextBox x:Name="InviteDevice" PlaceholderText="Member’s device code"/><ComboBox x:Name="InviteRole" SelectedIndex="0"><ComboBoxItem Content="contributor"/><ComboBoxItem Content="viewer"/><ComboBoxItem Content="admin"/></ComboBox><Button Content="Create invitation" Click="InviteMember"/><TextBox x:Name="GeneratedInvitation" IsReadOnly="True" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
  </NavigationView></Grid>
</Window>
